// Prisma schema for the Verifone VR360 app (PostgreSQL).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Shopify session storage (required shape for @shopify/shopify-app-session-storage-prisma).
model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?

  @@index([shop])
}

// One settings document per shop. `data` is validated by app/lib/settings.schema.ts;
// the VR360 password inside it is stored encrypted (app/lib/crypto.server.ts).
model ShopSettings {
  shop      String   @id
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum DocumentKind {
  INVOICE
  CREDIT_FULL
  CREDIT_REFUND
}

enum DocumentStatus {
  PENDING
  SUCCESS
  FAILED
}

// Every invoice / credit note issued (or attempted) in VR360. Source of truth for
// duplicate protection and for the order-details block.
model Document {
  id          Int            @id @default(autoincrement())
  shop        String
  orderId     String // numeric Shopify order id (without gid prefix)
  orderName   String // "#1001"
  kind        DocumentKind
  refundId    String? // numeric refund id for CREDIT_REFUND
  status      DocumentStatus @default(PENDING)
  vr360DocNo  String?
  storeNo     Int?
  customerNo  Int?
  reference   String?
  totalAmount Decimal?       @db.Decimal(12, 2)
  error       String?
  requestXml  String?
  responseXml String?
  source      String // manual | auto | bulk | webhook
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([shop, orderId])
  @@index([shop, status, createdAt])
}

// Every SOAP call to VR360 (secrets masked, bodies truncated).
model RequestLog {
  id         Int      @id @default(autoincrement())
  shop       String
  method     String
  ok         Boolean
  httpStatus Int?
  durationMs Int
  orderId    String?
  error      String?
  request    String
  response   String
  createdAt  DateTime @default(now())

  @@index([shop, createdAt])
  @@index([shop, orderId])
}

enum SyncKind {
  TODAY
  MONTH
  PRODUCT
  SKU
}

enum SyncSource {
  SCHEDULE
  TRIGGER
  MANUAL
  WEBHOOK
}

enum SyncStatus {
  RUNNING
  SUCCESS
  FAILED
  SKIPPED
}

// Stock sync run log (kept to the last 200 per shop).
model SyncRun {
  id         Int        @id @default(autoincrement())
  shop       String
  kind       SyncKind
  source     SyncSource
  status     SyncStatus @default(RUNNING)
  received   Int        @default(0)
  updated    Int        @default(0)
  unchanged  Int        @default(0)
  missing    Int        @default(0)
  skipped    Int        @default(0)
  message    String?
  details    Json?
  durationMs Int?
  startedAt  DateTime   @default(now())
  finishedAt DateTime?

  @@index([shop, startedAt])
}

// SKU -> inventory item cache so a sync run does not search 4,000 variants in GraphQL.
model SkuCache {
  shop            String
  sku             String
  inventoryItemId String
  variantId       String
  productId       String
  tracked         Boolean  @default(true)
  duplicate       Boolean  @default(false)
  updatedAt       DateTime @updatedAt

  @@id([shop, sku])
  @@index([shop, productId])
}
