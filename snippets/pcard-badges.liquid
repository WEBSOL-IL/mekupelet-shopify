{%- liquid
  assign selected_variant = product.selected_or_first_available_variant
  assign compare_at_price = selected_variant.compare_at_price
  assign price = selected_variant.price
  assign on_sale = false
  if compare_at_price > price
    assign on_sale = true
  endif

  assign show_soldout = settings.pcard_show_badge_soldout
  assign show_on_sale_badge = settings.pcard_show_sale_badge

  unless on_sale
    assign show_on_sale_badge = false
  endunless

  # MK-CUSTOM start: automatic "new" (created within settings.mk_new_days) and "best seller"
  # (member of settings.mk_bestseller_collection) badges; the tags keep working as overrides
  assign mk_new_auto = false
  if settings.mk_new_days > 0 and product.created_at != blank
    assign mk_created = product.created_at | date: '%s' | plus: 0
    assign mk_window = settings.mk_new_days | times: 86400
    assign mk_cutoff = 'now' | date: '%s' | plus: 0 | minus: mk_window
    if mk_created > mk_cutoff
      assign mk_new_auto = true
    endif
  endif
  assign mk_hot_auto = false
  if settings.mk_bestseller_collection != blank
    for mk_col in product.collections
      if mk_col.handle == settings.mk_bestseller_collection.handle
        assign mk_hot_auto = true
        break
      endif
    endfor
  endif
  # MK-CUSTOM end
-%}
{%- if product.available == false or on_sale or product.tags.size > 0 or mk_new_auto or mk_hot_auto -%}
  <div class="product-card__badge">
    {%- if product.available == false and show_soldout -%}
      <span class="f-badge f-badge--soldout" aria-hidden="true">
        {{- 'products.product.sold_out' | t -}}
      </span>
    {%- endif -%}
    {%- if show_on_sale_badge and product.available -%}
      {%- liquid
        assign sale_badge = ''
        assign amount = 0
        case settings.pcard_sale_badge_type
          when 'show_percentage'
            if compare_at_price > price
              assign amount = compare_at_price | minus: price | times: 100 | divided_by: compare_at_price
            endif
            # MK-CUSTOM start: "20% הנחה" instead of "-20%"
            assign sale_badge = 'products.product.percent_off_badge' | t: amount: amount
            # MK-CUSTOM end
          when 'show_amount'
            if compare_at_price > price
              assign amount = compare_at_price | minus: price | money
            endif
            assign sale_badge = 'products.product.price.save_price_html' | t: amount: amount
          else
            assign sale_badge = 'products.product.on_sale' | t
        endcase
      -%}
      <span class="f-badge f-badge--sale" aria-hidden="true">{{- sale_badge -}}</span>
    {%- endif -%}
    {%- liquid
      assign new_tags_list = settings.product_new_tags | newline_to_br | strip_newlines | split: '<br />'
      assign hot_tags_list = settings.product_hot_tags | newline_to_br | strip_newlines | split: '<br />'
      assign coming_tags_list = settings.product_coming_tags | newline_to_br | strip_newlines | split: '<br />'
    -%}
    {%- comment -%} MK-CUSTOM start: automatic badges first; a matching tag below is then skipped {%- endcomment -%}
    {%- liquid
      assign mk_new_done = false
      assign mk_hot_done = false
      if mk_new_auto
        assign mk_new_done = true
        assign mk_label = 'products.product.badge_new' | t
        echo '<span class="f-badge f-badge--new">' | append: mk_label | append: '</span>'
      endif
      if mk_hot_auto
        assign mk_hot_done = true
        assign mk_label = 'products.product.badge_hot' | t
        echo '<span class="f-badge f-badge--hot">' | append: mk_label | append: '</span>'
      endif
    -%}
    {%- comment -%} MK-CUSTOM end {%- endcomment -%}
    {%- for tag in product.tags -%}
      {%- liquid
        assign tag_handle = tag | handle
        assign badge_type = ''

        for item in new_tags_list
          assign item_handle = item | handle
          if tag_handle == item_handle
            assign badge_type = 'new'
            break
          endif
        endfor

        for item in hot_tags_list
          assign item_handle = item | handle
          if tag_handle == item_handle
            assign badge_type = 'hot'
            break
          endif
        endfor

        for item in coming_tags_list
          assign item_handle = item | handle
          if tag_handle == item_handle
            assign badge_type = 'coming'
            break
          endif
        endfor

        if badge_type == blank
          continue
        endif
        # MK-CUSTOM start: no duplicate when the automatic badge is already shown
        if badge_type == 'new' and mk_new_done
          continue
        endif
        if badge_type == 'hot' and mk_hot_done
          continue
        endif
        # MK-CUSTOM end
      -%}
      <span class="f-badge f-badge--{{ badge_type }}">{{ tag }}</span>
    {%- endfor -%}
  </div>
{%- endif -%}
