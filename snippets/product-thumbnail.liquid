{% comment %}theme-check-disable ImgLazyLoading{% endcomment %}
{% comment %}
  Renders a product thumbnail with a modal-opener

  Accepts:
  - media: {Object} Product Media object
  - media_count: {Number} Number of media objects
  - position: {String} Position of the media. Used for accessible label.
  - desktop_layout: {String} Layout of the media for desktop.
  - mobile_layout: {String} Layout of the media for mobile.
  - loop: {Boolean} Enable video looping (optional)
  - modal_id: {String} The product modal that will be shown by clicking the thumbnail
  - xr_button: {Boolean} Renders the "View in your space" button (shopify-xr-button) if the media is a 3D Model
  - media_width: {Float} The width percentage that the media column occupies on desktop.
  - context: {String} Where the gallery renders: 'quickview' loads the first media lazily, without preload (optional)

  Usage:
  {% render 'product-thumbnail',
    media: media,
    position: forloop.index,
    loop: section.settings.enable_video_looping,
    modal_id: section.id
  %}
{% endcomment %}
{%- liquid
  assign desktop_columns = 1
  if desktop_layout == 'columns' and media_count > 1
    assign desktop_columns = 2
  endif

  assign loading = 'lazy'
  assign fetchpriority = 'low'
  assign preload = false

  if position < desktop_columns and context != 'quickview'
    assign loading = 'eager'
    assign fetchpriority = 'high'
    comment
      The first media is the product page's LCP. A `<link rel=preload>` emitted right here (the preload
      scanner sees it long before the <img> deep in the gallery markup) starts the request at TTFB.
      `image_tag preload: true` (a Link header) would start it even earlier but cannot carry
      fetchpriority, so Chrome queues it at Low — behind fonts, pixels and thumbnails on a busy 4G
      connection (measured: 0.7s load delay + a starved download on a live store).

      Not in a quick view: its content arrives after the page has loaded, and on product pages the
      overlay renders hidden with the page's own product, where an eager, high priority image would
      compete with the real LCP.
    endcomment
    assign preload = true
  elsif position < desktop_columns
    # The quick view's first media: lazy (loads once the modal shows it) at normal priority.
    assign fetchpriority = 'auto'
  endif
-%}
{%- capture sizes -%}
{%- if desktop_columns > 1 -%}
(max-width: 767px) calc(100vw - 3rem), calc(((min({{ settings.page_width | plus: 30 }}px, 100vw) * {{ media_width }}) - 4.5rem - {{ desktop_columns | times: 1 | minus: 1 }}rem) / {{ desktop_columns }})
{%- else -%}
(max-width: 767px) calc(100vw - 3rem), calc(((min({{ settings.page_width | plus: 30 }}px, 100vw) * {{ media_width }}) - 4.5rem) / {{ desktop_columns }})
{%- endif -%}
{%- endcapture -%}
<div
  tabindex="-1"
  class="product__media-item swiper-slide"
  data-media-id="{{ media.id }}"
  data-media-type="{{ media.media_type }}"
  data-media-index="{{ position }}"
  data-src="{{ media.preview_image | image_url: width: 1946 }}"
  data-pswp-width="{{ media.preview_image.width }}"
  data-pswp-height="{{ media.preview_image.width | divided_by: media.preview_image.aspect_ratio | ceil }}"
>
  <div
    class="product__media-item-container relative flex overflow-hidden blocks-radius media-type-{{ media.media_type }}"
    style="--aspect-ratio: {{ media.aspect_ratio | default: 1.0 }};"
  >
    {%- case media.media_type -%}
      {%- when 'model' -%}
        <product-model class="deferred-media no-js-hidden" data-media-id="{{ media.id }}">
          <button id="Deferred-Poster-{{ media.id }}" class="deferred-media__poster media-wrapper" type="button">
            {{
              media.preview_image
              | image_url: width: 1946
              | image_tag:
                is: 'image-lazy',
                loading: loading,
                fetchpriority: fetchpriority,
                sizes: sizes,
                widths: '400, 620, 690, 810, 980, 1240, 1380, 1620, 1960'
            }}
            <span class="deferred-media__poster-button motion-reduce">
              <span class="visually-hidden">{{ 'products.product.media.play_model' | t }}</span>
              {%- render 'icon-3d-model' -%}
            </span>
          </button>
          <template>
            {{- media | media_tag: image_size: '2048x', toggleable: true -}}
          </template>
        </product-model>
        {%- if xr_button -%}
          <button
            class="product__xr-button btn btn--primary absolute z-1 bottom-0 left-0 right-0"
            type="button"
            aria-label="{{ 'products.product.xr_button_label' | t }}"
            data-shopify-xr
            data-shopify-model3d-id="{{ media.id }}"
            data-shopify-title="{{ product.title | escape }}"
            data-shopify-xr-hidden
          >
            {{ 'products.product.xr_button' | t }}
          </button>
        {%- endif -%}
      {%- when 'video' -%}
        {%- render 'video',
          video: media,
          muted: true,
          autoplay: true,
          controls: true,
          loop: loop,
          show_play_button: true
        -%}
      {%- when 'external_video' -%}
        {%- render 'video',
          video_url: media,
          video_url_type: media.host,
          video_url_id: media.external_id,
          cover_image: media.preview_image,
          muted: true,
          autoplay: true,
          controls: true,
          loop: loop,
          show_play_button: true
        -%}
      {%- else -%}
        {%- if preload -%}
          {%- liquid
            assign preload_srcset = ''
            assign preload_widths = '400, 620, 690, 810, 980, 1240, 1380, 1620, 1960' | remove: ' ' | split: ','
            for w in preload_widths
              assign w_num = w | plus: 0
              if w_num <= media.preview_image.width
                assign candidate = media.preview_image | image_url: width: w_num
                assign preload_srcset = preload_srcset | append: candidate | append: ' ' | append: w | append: 'w, '
              endif
            endfor
            assign preload_srcset = preload_srcset | remove_last: ', '
          -%}
          {% # `image_tag preload: true` (what AssetPreload asks for) is a Link header with no fetchpriority: Chrome queues it Low. Measured on a live store — see the comment above. %}
          {% # theme-check-disable AssetPreload %}
          <link rel="preload" as="image" fetchpriority="high" imagesrcset="{{ preload_srcset }}" imagesizes="{{ sizes | strip }}">
          {% # theme-check-enable AssetPreload %}
        {%- endif -%}
        <motion-element data-motion="zoom-out-sm" class="block product__media media-wrapper">
          {{
            media.preview_image
            | image_url: width: 1946
            | image_tag:
              is: 'image-lazy',
              loading: loading,
              fetchpriority: fetchpriority,
              sizes: sizes,
              widths: '400, 620, 690, 810, 980, 1240, 1380, 1620, 1960'
          }}
        </motion-element>
        {%- if enable_image_zoom -%}
          <div
            class="product__media-icon btn btn--white btn--small btn--icon btn--icon-circle"
            aria-hidden="true"
          >
            <span class="btn__text flex items-center">{%- render 'icon-zoom' -%}</span>
          </div>
          <button
            class="product__media-zoom btn--inherit js-photoswipe--zoom"
            type="button"
            aria-haspopup="dialog"
            data-media-id="{{ media.id }}"
            data-media-type="{{ media.media_type }}"
            data-media-index="{{ position }}"
          >
            <span class="visually-hidden">
              {{ 'products.product.media.open_media' | t: index: position }}
            </span>
          </button>
        {%- endif -%}
    {%- endcase -%}
  </div>
</div>
