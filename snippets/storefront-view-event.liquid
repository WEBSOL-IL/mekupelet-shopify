{% comment %}
  Renders the element that dispatches a Shopify standard view event (shopify:product:view,
  shopify:collection:view or shopify:cart:view) for a product, collection or cart.
  The custom element is defined in snippets/storefront-events.liquid.
  Accepts:
    - resource: {object} product, collection or cart (required)
    - context: {string} where the view happens (optional)
        product: 'page' | 'search' | 'collection' | 'dialog' | 'recommendation'
        cart: 'page' | 'dialog'
        collection: ignored
    - trigger: {string} 'connect' (default, fires when added to the page) | 'intersect' (fires when
        half of it scrolls into view) | 'manual' (fires on dispatchViewEvent())

  An 'intersect' element fills its nearest positioned ancestor, so it measures what the buyer sees.
  Every other trigger renders hidden.

  Usage:
  {% render 'storefront-view-event', resource: product, context: 'page' %}
{% endcomment %}

{%- liquid
  if context != blank
    assign view_event_payload = resource | standard_event_data: 'view', context: context
  else
    assign view_event_payload = resource | standard_event_data: 'view'
  endif
-%}
<storefront-view-event
  view-event-payload="{{ view_event_payload | escape }}"
  {% if trigger == 'intersect' or trigger == 'manual' %}
    view-event-trigger="{{ trigger }}"
  {% endif %}
  {% unless trigger == 'intersect' %}
    hidden
  {% endunless %}
  aria-hidden="true"
></storefront-view-event>
