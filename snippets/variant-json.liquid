{%- doc -%}
  Renders one variant as the trimmed JSON object the cached-variant optimistic update reads.

  Rendered per variant by product-variant-picker.liquid (the [data-variants-cache] array) and for a
  single server-resolved variant by sections/variant-data.liquid, so the cache and the fallback fetch
  speak one shape and cannot drift apart.

  Trimmed rather than `variant | json`: that ships fields nothing here reads, and it omits
  inventory_quantity and inventory_policy entirely, which is why in_stock has to be computed here,
  where Liquid still has them. A `continue` policy variant that is out of stock is `available` while
  its badge must still read sold out (see product-badges.liquid).

  unit_price_measurement is built field-by-field rather than `| json`ed directly: Shopify's
  UnitPriceMeasurement drop rejects that filter outright ({"error":"json not allowed for this
  object"}), unlike the plain scalars read off it. Only reference_value/reference_unit are emitted
  since FoxTheme.Currency.getBaseUnit is the only reader.

  @param {object} variant - Variant object
  @param {object} [inventory_block] - The section's inventory block, when it has one: adds the variant's
    inventory as that block shows it (status against its threshold, and the quantity only where the block
    displays it - in its message or its low-stock bar)

  @example
  {% render 'variant-json', variant: variant %}
{%- enddoc -%}
{%- liquid
  assign in_stock = true
  if variant.inventory_management == 'shopify' and variant.inventory_quantity < 1 and variant.inventory_policy != 'continue'
    assign in_stock = false
  endif

  # Mirrors the inventory block in product-information-blocks.liquid.
  assign inventory_status = 'untracked'
  assign inventory_quantity = nil
  if variant.inventory_management == 'shopify'
    if variant.inventory_quantity > 0
      if variant.inventory_quantity <= inventory_block.settings.inventory_threshold
        assign inventory_status = 'low-stock'
        if inventory_block.settings.show_inventory_quantity or variant.inventory_quantity < inventory_block.settings.inventory_threshold
          assign inventory_quantity = variant.inventory_quantity
        endif
      else
        assign inventory_status = 'in-stock'
        if inventory_block.settings.show_inventory_quantity
          assign inventory_quantity = variant.inventory_quantity
        endif
      endif
    elsif variant.inventory_policy == 'continue'
      assign inventory_status = 'continue'
    else
      assign inventory_status = 'out-of-stock'
    endif
  endif
-%}
{
  "id": {{ variant.id }},
  "options": {{ variant.options | json }},
  "available": {{ variant.available }},
  "in_stock": {{ in_stock }},
  "inventory": {% if inventory_block %}{"status": {{ inventory_status | json }}, "quantity": {{ inventory_quantity | json }}}{% else %}null{% endif %},
  "sku": {{ variant.sku | json }},
  "barcode": {{ variant.barcode | json }},
  "quantity_rule": {"min": {{ variant.quantity_rule.min | json }}, "max": {{ variant.quantity_rule.max | json }}, "increment": {{ variant.quantity_rule.increment | json }}},
  "price": {{ variant.price }},
  "compare_at_price": {{ variant.compare_at_price | json }},
  "unit_price": {{ variant.unit_price | json }},
  "unit_price_measurement": {% if variant.unit_price_measurement %}{"reference_value": {{ variant.unit_price_measurement.reference_value | json }}, "reference_unit": {{ variant.unit_price_measurement.reference_unit | json }}}{% else %}null{% endif %},
  "featured_media": {% if variant.featured_media %}{"id": {{ variant.featured_media.id }}, "position": {{ variant.featured_media.position }}}{% else %}null{% endif %}
}
