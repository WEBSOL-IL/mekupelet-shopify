{%- comment -%}
  MK product media row: files from a product metafield list (custom.customer_photos = images sent
  by customers, custom.product_videos = MP4 reels uploaded to Files) in Hyper's slider. One section,
  two instances (setting `source`). Renders nothing when the list is empty. Videos use Hyper's
  video snippet (poster + play button, loads the file on click), images use image_tag with srcset.
{%- endcomment -%}
{%- liquid
  if section.settings.source == 'videos'
    assign files = product.metafields.custom.product_videos.value
  else
    assign files = product.metafields.custom.customer_photos.value
  endif
-%}
{%- if files != blank and files.size > 0 -%}
  {%- liquid
    assign columns_desktop = section.settings.columns
    assign columns_mobile = section.settings.columns_mobile | plus: 0
    assign columns_tablet = columns_desktop | minus: 1
    if columns_desktop < 3 or request.design_mode
      assign columns_tablet = columns_desktop
    endif
    assign total = files.size
    assign enable_swipe_mobile = false
    if total > columns_mobile
      assign enable_swipe_mobile = true
    endif
  -%}
  {%- capture image_sizes -%}
    (max-width: 767px) calc((100vw - 30px) / {{ columns_mobile }}),
    (max-width: 1023px) calc((100vw - 30px) / {{ columns_tablet }}),
    {{ settings.page_width | divided_by: columns_desktop }}px
  {%- endcapture -%}
  <script src="{{ 'product-slider.js' | asset_url }}" defer="defer"></script>
  {% style %}
    .section-{{ section.id }} {
      --section-padding-top: {{ section.settings.padding_top }}px;
      --section-padding-bottom: {{ section.settings.padding_bottom }}px;
      --f-columns-mobile: {{ columns_mobile }};
      --f-columns-md: {{ columns_tablet }};
      --f-columns-lg: {{ columns_desktop }};
      --mk-media-ratio: {{ section.settings.ratio }};
    }
  {% endstyle %}
  {% render 'divider', show_divider: section.settings.show_section_divider, divider_width: section.settings.divider_width %}
  <div
    class="section section-{{ section.id }} section--padding mk-product-media mk-product-media--{{ section.settings.source }} page-width page-width--{{ section.settings.container }} color-{{ section.settings.color_scheme }}"
    data-id="{{ section.id }}"
  >
    {% render 'section-heading', section_settings: section.settings %}
    <product-slider
      class="block"
      data-section-id="{{ section.id }}"
      data-enable-slider="{{ section.settings.enable_slider }}"
      data-items="{{ columns_desktop }}"
      data-tablet-items="{{ columns_tablet }}"
      data-total-items="{{ total }}"
      data-pagination-type="progressbar"
      data-navigation-position="bottom"
    >
      <div
        class="products-grid-wrap{% if section.settings.enable_slider %} swiper swiper-equal-height overflow-visible{% endif %}{% if enable_swipe_mobile %} swipe-mobile swipe-mobile--{{ columns_mobile }}-cols{% endif %}"
        id="product-list-{{ section.id }}"
      >
        <div class="f-grid f-grid--gap-{{ section.settings.column_gap }}{% if section.settings.enable_slider %} swiper-wrapper{% endif %}{% if enable_swipe_mobile %} swipe-mobile__inner{% endif %}">
          {%- for file in files -%}
            <div class="f-column swiper-slide">
              <div class="mk-product-media__item blocks-radius">
                {%- if file.media_type == 'video' -%}
                  {% render 'video',
                    video: file,
                    autoplay: false,
                    loop: true,
                    muted: false,
                    show_play_button: true,
                    cover_image: file.preview_image,
                    sizes: image_sizes,
                    class: 'mk-product-media__video'
                  %}
                {%- elsif file.preview_image != blank -%}
                  {{ file.preview_image | image_url: width: 1000 | image_tag: loading: 'lazy', widths: '300, 400, 500, 600, 800, 1000', sizes: image_sizes, alt: file.alt | default: product.title, class: 'mk-product-media__image', is: 'image-lazy' }}
                {%- endif -%}
              </div>
            </div>
          {%- endfor -%}
        </div>
      </div>
      {%- if section.settings.enable_slider -%}
        <div class="swiper-controls swiper-controls--grouped swiper-controls--pagination-progressbar hidden{% if total > columns_tablet %} md:flex{% endif %}{% if total > columns_desktop %} lg:flex{% else %} lg:hidden{% endif %}">
          <button class="swiper-button swiper-button-prev btn" name="previous" aria-label="{{ 'general.slider.previous_slide' | t }}"><span class="btn__text">{% render 'icon-caret-left' %}</span></button>
          <div class="swiper-pagination"></div>
          <button class="swiper-button swiper-button-next btn" name="next" aria-label="{{ 'general.slider.next_slide' | t }}"><span class="btn__text">{% render 'icon-caret-right' %}</span></button>
        </div>
      {%- endif -%}
      {%- if enable_swipe_mobile -%}
        <scroll-progress-bar class="md:hidden" target="product-list-{{ section.id }}">
          <div class="progress-container"><div class="progress-bar no-empty"></div></div>
        </scroll-progress-bar>
      {%- endif -%}
    </product-slider>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "MK Product media",
  "tag": "section",
  "class": "section",
  "enabled_on": { "templates": ["product"] },
  "settings": [
    { "type": "paragraph", "content": "Files from a product metafield list: customer photos (custom.customer_photos) or MP4 reels (custom.product_videos). Hidden when the product has none." },
    { "type": "select", "id": "source", "label": "Source", "options": [{ "value": "photos", "label": "Customer photos (custom.customer_photos)" }, { "value": "videos", "label": "Videos (custom.product_videos)" }], "default": "photos" },
    { "type": "select", "id": "container", "label": "t:general.container.label", "options": [{ "value": "full", "label": "t:general.container.options__full.label" }, { "value": "fixed", "label": "t:general.container.options__fixed.label" }], "default": "fixed" },
    { "type": "color_scheme", "id": "color_scheme", "label": "t:general.colors.label", "default": "scheme-1" },
    { "type": "select", "id": "section_header_alignment", "label": "Heading alignment", "options": [{ "value": "left", "label": "Start" }, { "value": "center", "label": "Center" }], "default": "center" },
    { "type": "text", "id": "subheading", "label": "Subheading" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "תמונות אמיתיות ששלחתם לי" },
    { "type": "select", "id": "heading_size", "label": "Heading size", "options": [{ "value": "h3", "label": "Small" }, { "value": "h2", "label": "Medium" }, { "value": "h1", "label": "Large" }], "default": "h1" },
    { "type": "richtext", "id": "description", "label": "Description" },
    { "type": "select", "id": "ratio", "label": "Card ratio", "options": [{ "value": "1 / 1", "label": "Square" }, { "value": "4 / 5", "label": "Portrait 4:5" }, { "value": "9 / 16", "label": "Reel 9:16" }], "default": "1 / 1" },
    { "type": "range", "id": "columns", "min": 2, "max": 6, "step": 1, "label": "Columns (desktop)", "default": 5 },
    { "type": "select", "id": "columns_mobile", "label": "Columns (mobile)", "options": [{ "value": "1", "label": "1" }, { "value": "2", "label": "2" }], "default": "2" },
    { "type": "select", "id": "column_gap", "label": "Column gap", "options": [{ "value": "small", "label": "Small" }, { "value": "medium", "label": "Medium" }, { "value": "large", "label": "Large" }], "default": "medium" },
    { "type": "checkbox", "id": "enable_slider", "label": "Slider on desktop", "default": true },
    { "type": "header", "content": "t:general.padding.section_heading.content" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 2, "unit": "px", "label": "t:general.padding.top.label", "default": 60 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 2, "unit": "px", "label": "t:general.padding.bottom.label", "default": 10 },
    { "type": "checkbox", "id": "show_section_divider", "label": "Section divider", "default": false },
    { "type": "select", "id": "divider_width", "label": "Divider width", "options": [{ "value": "fixed", "label": "Fixed" }, { "value": "full", "label": "Full" }], "default": "fixed" }
  ],
  "presets": [{ "name": "MK Product media" }]
}
{% endschema %}
