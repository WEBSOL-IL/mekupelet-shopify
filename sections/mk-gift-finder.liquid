{{ 'mk-gift-finder.css' | asset_url | stylesheet_tag }}
<script src="{{ 'mk-gift-finder.js' | asset_url }}" defer="defer"></script>
{%- liquid
  assign container = section.settings.container
  assign target_url = section.settings.target_url | default: routes.all_products_collection_url
  assign form_id = 'MkGiftFinder-' | append: section.id
-%}
{% style %}
  #section-{{ section.id }} {
    --section-padding-top: {{ section.settings.padding_top }}px;
    --section-padding-bottom: {{ section.settings.padding_bottom }}px;
  }
{% endstyle %}
<div
  id="section-{{ section.id }}"
  class="mk-gift-finder section color-{{ section.settings.color_scheme }}"
  data-section-id="{{ section.id }}"
>
  <div class="{% if container == 'fixed' %}page-width{% endif %}">
    <mk-gift-finder class="mk-gift-finder__card">
      {%- if section.settings.heading != blank -%}
        <h2 class="mk-gift-finder__heading h5">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      <form
        id="{{ form_id }}"
        class="mk-gift-finder__form"
        action="{{ target_url }}"
        method="get"
        data-target="{{ target_url }}"
      >
        {%- for block in section.blocks -%}
          {%- liquid
            assign param = block.settings.param | strip
            assign option_lines = block.settings.options | newline_to_br | strip_newlines | split: '<br />'
            assign select_id = form_id | append: '-' | append: block.id
          -%}
          {%- if param != blank and option_lines.size > 0 -%}
            <div class="mk-gift-finder__field select" {{ block.shopify_attributes }}>
              <label class="visually-hidden" for="{{ select_id }}">{{ block.settings.label | escape }}</label>
              <select
                id="{{ select_id }}"
                name="{{ param }}"
                class="form-control form-control--select mk-gift-finder__select"
                data-param="{{ param }}"
              >
                <option value="">{{ block.settings.label | escape }}</option>
                {%- for line in option_lines -%}
                  {%- assign parts = line | split: '|' -%}
                  {%- assign option_label = parts[0] | strip -%}
                  {%- assign option_value = parts[1] | default: parts[0] | strip -%}
                  {%- if option_label != blank -%}
                    <option value="{{ option_value | escape }}">{{ option_label | escape }}</option>
                  {%- endif -%}
                {%- endfor -%}
              </select>
              {% render 'icon-caret-down', size: '2xs' %}
            </div>
          {%- endif -%}
        {%- endfor -%}
        <button type="submit" class="btn {{ section.settings.button_style }} mk-gift-finder__submit">
          <span class="btn__text">{{ section.settings.button_label | escape }}</span>
        </button>
      </form>
    </mk-gift-finder>
  </div>
</div>

{% schema %}
{
  "name": "MK Gift finder",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer", "custom.overlay"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "Each block is one dropdown. Options are written as `Label|value`, one per line. The value is sent to the target collection as a storefront filter parameter, so the matching filter must be enabled in Search & Discovery. Price uses `min-max` values with the `filter.v.price` parameter."
    },
    {
      "type": "select",
      "id": "container",
      "label": "t:general.container.label",
      "options": [
        { "value": "full", "label": "t:general.container.options__full.label" },
        { "value": "fixed", "label": "t:general.container.options__fixed.label" }
      ],
      "default": "fixed"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:general.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading (optional)"
    },
    {
      "type": "url",
      "id": "target_url",
      "label": "Target collection",
      "info": "The collection that receives the filters. Defaults to all products."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "מצאו לי מתנה"
    },
    {
      "type": "select",
      "id": "button_style",
      "label": "Button style",
      "options": [
        { "value": "btn--primary", "label": "Primary" },
        { "value": "btn--secondary", "label": "Secondary" },
        { "value": "btn--outline", "label": "Outline" }
      ],
      "default": "btn--primary"
    },
    {
      "type": "header",
      "content": "t:general.padding.section_heading.content"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "t:general.padding.top.label",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "t:general.padding.bottom.label",
      "default": 24
    }
  ],
  "blocks": [
    {
      "type": "filter",
      "name": "Dropdown",
      "limit": 6,
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label (shown as the first option)",
          "default": "גיל"
        },
        {
          "type": "text",
          "id": "param",
          "label": "Filter parameter",
          "default": "filter.p.tag",
          "info": "Examples: filter.p.tag, filter.p.vendor, filter.p.product_type, filter.v.price, filter.p.m.custom.age"
        },
        {
          "type": "textarea",
          "id": "options",
          "label": "Options (Label|value, one per line)",
          "default": "0-6 חודשים|גיל-0-6\n6-12 חודשים|גיל-6-12\nשנה-שנה וחצי|גיל-12-18\nשנה וחצי-שנתיים|גיל-18-24\nשנתיים-שלוש|גיל-24-36\n3+|גיל-3-plus"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "MK Gift finder",
      "blocks": [
        { "type": "filter" },
        {
          "type": "filter",
          "settings": {
            "label": "סוג מתנה",
            "param": "filter.p.product_type",
            "options": "משחקי קופסה|משחקי קופסה\nספרים|ספרים\nצעצועי עץ|צעצועי עץ\nיצירה|יצירה"
          }
        },
        {
          "type": "filter",
          "settings": {
            "label": "מותג",
            "param": "filter.p.vendor",
            "options": "Ulanik|Ulanik\nKooglo|Kooglo\nJaba Daba Do|Jaba Daba Do"
          }
        },
        {
          "type": "filter",
          "settings": {
            "label": "טווח מחירים",
            "param": "filter.v.price",
            "options": "עד 50 ₪|0-50\n50–100 ₪|50-100\n100–200 ₪|100-200\n200 ₪ ומעלה|200-100000"
          }
        }
      ]
    }
  ]
}
{% endschema %}
