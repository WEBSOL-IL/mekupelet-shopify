{% style %}
  .template-404 p {
    margin: 1.6rem 0 0;
  }
  .template-404 .btn {
    margin-top: 3.2rem;
  }
{% endstyle %}
<div
  class="template-404 section section--padding"
  style="--section-padding-top: 100px;--section-padding-bottom: 100px;"
>
  <div class="page-width text-center">
    <{{ section.settings.heading_tag }} class="title {{ section.settings.heading_size }}">{{ 'templates.404.title' | t }}</{{ section.settings.heading_tag }}>
    <p class="text-base text-subtext">{{ 'templates.404.subtext' | t }}</p>
    <a href="{{ routes.all_products_collection_url }}" class="btn btn--primary">
      <span class="btn__text">
        {{ 'general.continue_shopping' | t }}
      </span>
    </a>
  </div>
</div>
{% schema %}
{
  "name": "t:sections.main-404.name",
  "settings": [
    {
      "type": "header",
      "content": "t:general.header__heading.content"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "t:general.text_size.heading.label",
      "default": "h2",
      "options": [
        {
          "value": "h5",
          "label": "t:general.text_size.options__h5.label"
        },
        {
          "value": "h4",
          "label": "t:general.text_size.options__h4.label"
        },
        {
          "value": "h3",
          "label": "t:general.text_size.options__h3.label"
        },
        {
          "value": "h2",
          "label": "t:general.text_size.options__h2.label"
        },
        {
          "value": "h1",
          "label": "t:general.text_size.options__h1.label"
        },
        {
          "value": "hd2",
          "label": "t:general.text_size.options__hd2.label"
        },
        {
          "value": "hd1",
          "label": "t:general.text_size.options__hd1.label"
        }
      ]
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "t:general.heading_tag.label",
      "info": "t:general.heading_tag.info",
      "default": "h1",
      "options": [
        {
          "value": "h1",
          "label": "t:general.heading_tag.options__h1.label"
        },
        {
          "value": "h2",
          "label": "t:general.heading_tag.options__h2.label"
        },
        {
          "value": "h3",
          "label": "t:general.heading_tag.options__h3.label"
        },
        {
          "value": "h4",
          "label": "t:general.heading_tag.options__h4.label"
        },
        {
          "value": "h5",
          "label": "t:general.heading_tag.options__h5.label"
        },
        {
          "value": "h6",
          "label": "t:general.heading_tag.options__h6.label"
        }
      ]
    }
  ]
}
{% endschema %}